{
  "name": "ai-studio-angular-app",
  "version": "0.0.0",
  "scripts": {
    "audit:arch": "tsx agentica/tools/cli.ts audit",
    "audit:arch:strict": "tsx agentica/tools/cli.ts audit --strict",
    "build": "ng build",
    "dev": "cross-env ng serve --port=4307 --host=0.0.0.0 ${DISABLE_HMR:+--live-reload=false}",
    "lint": "pnpm run lint:ts && pnpm run lint:html",
    "lint:fix": "oxlint --fix",
    "lint:html": "ng lint",
    "lint:ts": "oxlint",
    "ng": "ng",
    "serve:ssr:app": "node dist/app/server/server.mjs",
    "start": "ng serve",
    "test": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "watch": "ng build --watch --configuration development",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "private": true,
  "dependencies": {
    "3dmol": "^2.5.4",
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "22.2.2",
    "@angular/ssr": "^21.0.0",
    "@fontsource/material-icons": "^5.3.0",
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "smiles-drawer": "^2.2.1",
    "three": "^0.183.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/three": "^0.183.1",
    "@webgpu/types": "^0.1.74",
    "angular-eslint": "21.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "jsdom": "^27.0.0",
    "oxlint": "^1.87.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.47.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@jridgewell/sourcemap-codec": "^1.6.0"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}